# 复制为 /etc/byebyeocs/backup.env 并填写本地路径、age 公钥和异机 SSH 目标。
# 不要把私钥、密码写在这个文件里；SSH 认证使用运行备份账号自己的受限密钥/known_hosts。
# age 是公开依赖（https://age-encryption.org/），解密身份私钥必须另行离线保管。

# 主配置目录会整体进入加密归档，包括应用密钥、身份索引密钥、密钥环和数据库 DSN。
BYEBYEOCS_CONFIG_DIR=/etc/byebyeocs
BYEBYEOCS_DSN_FILE=/etc/byebyeocs/secrets/database.dsn
BYEBYEOCS_TIKU_CONFIG_DIR=/etc/ocs-tiku
# 没有启用题库时留空；若题库活动配置存在而此处为空，备份会失败。
BYEBYEOCS_TIKU_DSN_FILE=/etc/ocs-tiku/secrets/database.dsn

# operations 读取的成功恢复点状态；只在异机校验成功后原子更新。
BYEBYEOCS_BACKUP_STATUS_FILE=/etc/byebyeocs/secrets/backup-status.json
BYEBYEOCS_BACKUP_STATUS_OWNER=byebyeocs
BYEBYEOCS_BACKUP_STAGING=/var/backups/byebyeocs
# 仅 --local-only 使用；默认保留最近 3 份，单份上限 2 GiB，避免本地临时盘被归档撑满。
BYEBYEOCS_LOCAL_RETAIN_COUNT=3
BYEBYEOCS_LOCAL_MAX_BYTES=2147483648

# age 公钥（recipient），不是私钥。留空时备份必须显式使用 --local-only。
BYEBYEOCS_AGE_RECIPIENT=
# 异机 SSH 目标为 user@host；目录必须已存在且对备份账号可写。
BYEBYEOCS_OFFSITE_SSH=
BYEBYEOCS_OFFSITE_DIR=
