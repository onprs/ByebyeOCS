[Unit]
Description=ByebyeOCS 独立题库 fork 服务
Documentation=https://github.com/onprs/ByebyeOCS
After=network-online.target
Wants=network-online.target
# 题库使用独立数据库/角色和独立服务用户；默认只监听回环地址。

[Service]
Type=simple
User=@TIKU_USER@
Group=@TIKU_USER@
# 配置中的相对密钥路径以该配置目录为基准。
WorkingDirectory=@TIKU_CONFIG_DIR@
ExecStart=@PREFIX@/current/bin/ocs-tiku-fork serve -config @TIKU_CONFIG_DIR@/ocs-tiku-fork.json
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=120
KillMode=control-group
RuntimeDirectory=ocs-tiku
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 程序目录只读；配置目录由题库用户拥有，供维护面板原子写回模型配置和私密密钥。
ReadOnlyPaths=@PREFIX@
ReadWritePaths=/run/ocs-tiku @TIKU_CONFIG_DIR@
CapabilityBoundingSet=
AmbientCapabilities=
TasksMax=128
LimitNOFILE=32768
MemoryHigh=192M
MemoryMax=384M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
